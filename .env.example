# OpenCode Usage Tracking — Environment Variables

# Path to your OpenCode SQLite database.
# Leave empty to use the default location:
#   Linux/macOS: ~/.local/share/opencode/opencode.db
#   Windows:     %USERPROFILE%\.local\share\opencode\opencode.db
OPENCODE_DB_PATH=

# Port the dashboard server runs on (default: 3777)
PORT=3777
